@page
@model RunningGearTracker_AquinoE.Pages.GearIndexModel
@{
    ViewData["Title"] = "Session Gear & Notes";
}

@* ── NAVBAR ──────────────────────────────────────────────────────────────── *@
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">🏃 Running Gear Tracker</a>
        <div class="navbar-nav ms-auto">
            <a class="nav-link" href="/">Dashboard</a>
            <a class="nav-link" href="/Sessions">All Sessions</a>
            <a class="nav-link active" href="/GearIndex">Gear Usage</a>
        </div>
    </div>
</nav>

<div class="container py-4">

    @* ════════════════════════════════════════════════════════════════════
       SECTION 1 — ADD / EDIT FORM
       ════════════════════════════════════════════════════════════════════ *@
    <div class="mb-5">
        <h4 class="mb-3 border-bottom pb-2">
            @(Model.IsEdit ? "✏️ Edit Gear Usage Record" : "➕ Link Gear to a Session")
        </h4>

        <div class="card shadow-sm">
            <div class="card-body">

                @if (Model.IsEdit)
                {
                    @* EDIT FORM — pre-filled from CurrentUsage loaded in OnGet *@
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="editUsage" />
                        <input type="hidden" name="UsageID" value="@Model.CurrentUsage.UsageID" />

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Session</label>
                                <select name="SessionID" class="form-select">
                                    @foreach (var session in Model.AllSessions)
                                    {
                                        if (session.SessionID == Model.CurrentUsage.SessionID)
                                        {
                                            <option value="@session.SessionID" selected>
                                                #@session.SessionID — @session.ActivityDate @session.Location
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@session.SessionID">
                                                #@session.SessionID — @session.ActivityDate @session.Location
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Gear</label>
                                <select name="GearID" class="form-select">
                                    @foreach (var gear in Model.AllGears)
                                    {
                                        if (gear.GearID == Model.CurrentUsage.GearID)
                                        {
                                            <option value="@gear.GearID" selected>
                                                @gear.Brand @gear.ModelName (@gear.Category)
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@gear.GearID">
                                                @gear.Brand @gear.ModelName (@gear.Category)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Notes</label>
                                <input type="text" name="Notes" class="form-control"
                                       value="@Model.CurrentUsage.Notes"
                                       placeholder="e.g. Felt tight on left shoe" />
                            </div>
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <button type="submit" class="btn btn-success">Update Record</button>
                            <a href="/GearIndex" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                }
                else
                {
                    @* ADD FORM — UsageID not sent; DB generates it via IDENTITY *@
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="addUsage" />

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Session</label>
                                @if (Model.AllSessions.Any())
                                {
                                    <select name="SessionID" class="form-select">
                                        <option value="">-- Select Session --</option>
                                        @foreach (var session in Model.AllSessions)
                                        {
                                            <option value="@session.SessionID">
                                                #@session.SessionID — @session.ActivityDate @session.Location
                                            </option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="form-control" disabled
                                           placeholder="No sessions yet" />
                                }
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Gear</label>
                                @if (Model.AllGears.Any())
                                {
                                    <select name="GearID" class="form-select">
                                        <option value="">-- Select Gear --</option>
                                        @foreach (var gear in Model.AllGears)
                                        {
                                            <option value="@gear.GearID">
                                                @gear.Brand @gear.ModelName (@gear.Category)
                                            </option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="form-control" disabled
                                           placeholder="No gear yet" />
                                }
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Notes</label>
                                <input type="text" name="Notes" class="form-control"
                                       placeholder="e.g. Felt tight on left shoe" />
                            </div>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary"
                                @(!Model.AllSessions.Any() || !Model.AllGears.Any() ? "disabled" : "")>
                                Link Gear to Session
                            </button>
                            @if (!Model.AllSessions.Any() || !Model.AllGears.Any())
                            {
                                <span class="text-muted ms-2 small">
                                    You need at least one session and one gear item registered first.
                                </span>
                            }
                        </div>
                    </form>
                }

            </div>
        </div>
    </div>

    @* ════════════════════════════════════════════════════════════════════
       SECTION 2 — ASSOCIATIVE TABLE
       ════════════════════════════════════════════════════════════════════ *@
    <div class="mb-4">
        <h4 class="mb-3 border-bottom pb-2">🔗 Session — Gear — Notes</h4>

        @if (Model.AllUsages.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover table-bordered mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Usage ID</th>
                                <th>Session ID</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Distance</th>
                                <th>Duration</th>
                                <th>Avg BPM</th>
                                <th>Gear</th>
                                <th>Category</th>
                                <th>Notes</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usage in Model.AllUsages)
                            {
                                <tr>
                                    <td>@usage.UsageID</td>
                                    <td>@usage.TrainingSessions.SessionID</td>
                                    <td>@usage.TrainingSessions.ActivityDate</td>
                                    <td>@usage.TrainingSessions.Location</td>
                                    <td>@usage.TrainingSessions.Distance_KM.ToString("F1") km</td>
                                    <td>@usage.TrainingSessions.Duration</td>
                                    <td>@usage.TrainingSessions.AvgHeartRate</td>
                                    <td>
                                        <strong>@usage.Gear.Brand</strong>
                                        @usage.Gear.ModelName
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@usage.Gear.Category</span>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(usage.Notes))
                                        {
                                            <span class="text-muted fst-italic">—</span>
                                        }
                                        else
                                        {
                                            @usage.Notes
                                        }
                                    </td>
                                    <td class="text-center" style="white-space:nowrap;">
                                        <a href="/GearIndex?editUsageId=@usage.UsageID"
                                           class="btn btn-sm btn-outline-primary me-1">Edit</a>

                                        <a href="/GearIndex?deleteUsageId=@usage.UsageID"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Delete this gear usage record?');">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* Summary counts *@
            <div class="mt-3 d-flex gap-3">
                <span class="text-muted small">
                    Total records: <strong>@Model.AllUsages.Count</strong>
                </span>
                <span class="text-muted small">
                    Sessions with gear: <strong>@Model.AllUsages.Select(u => u.SessionID).Distinct().Count()</strong>
                </span>
                <span class="text-muted small">
                    Gear items used: <strong>@Model.AllUsages.Select(u => u.GearID).Distinct().Count()</strong>
                </span>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                No gear usage records yet. Use the form above to link gear to a session.
            </div>
        }
    </div>

</div>
