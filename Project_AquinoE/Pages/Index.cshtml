@page
@model RunningGearTracker_AquinoE.Pages.IndexModel
@{
    ViewData["Title"] = "Running Gear Tracker";
    var categories = new[] { "Shoes", "Watch", "Apparel", "Socks", "Accessories", "Other" };
}

@* ── NAVBAR ──────────────────────────────────────────────────────────────── *@
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">🏃 Running Gear Tracker</a>
        <div class="navbar-nav ms-auto">
            <a class="nav-link active" href="/">Dashboard</a>
            <a class="nav-link" href="/Sessions">All Sessions</a>
            <a class="nav-link" href="/GearIndex">Gear Usage</a>
        </div>
    </div>
</nav>

<div class="container py-4">

    @*SECTION 1 — LOG A TRAINING SESSION*@
    <div class="mb-5">
        <h4 class="mb-3 border-bottom pb-2">📋 Log a Training Session</h4>

        <form method="post">
            @Html.AntiForgeryToken()
            @* Hidden field tells OnPost which action to run *@
            <input type="hidden" name="action" value="logSession" />

            <div class="card shadow-sm">
                <div class="card-body">

                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Date</label>
                            <input type="date" name="ActivityDate" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Location</label>
                            <input type="text" name="Location" class="form-control"
                                   placeholder="e.g. Rizal Park" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Distance (km)</label>
                            <input type="number" name="Distance_KM" step="0.01" min="0"
                                   class="form-control" placeholder="0.00" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Duration</label>
                            <input type="text" name="Duration" class="form-control"
                                   placeholder="hh:mm:ss" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Avg Heart Rate</label>
                            <input type="text" name="AvgHeartRate" class="form-control"
                                   placeholder="bpm" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Gear Used</label>

                        @if (Model.Gears.Any())
                        {
                            <div class="row g-2">
                                @foreach (var gear in Model.Gears)
                                {
                                    <div class="col-md-6">
                                        <div class="border rounded p-2 bg-light">
                                            <div class="form-check mb-1">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="SelectedGearIds"
                                                       value="@gear.GearID"
                                                       id="gear_@gear.GearID"
                                                       onchange="toggleNote(this, 'note_panel_@gear.GearID')" />
                                                <label class="form-check-label" for="gear_@gear.GearID">
                                                    <strong>@gear.Brand @gear.ModelName</strong>
                                                    <span class="badge bg-secondary ms-1">@gear.Category</span>
                                                </label>
                                            </div>
                                            @* Note field — hidden until checkbox is ticked *@
                                            <div id="note_panel_@gear.GearID" style="display:none;">
                                                <input type="text"
                                                       name="note_@gear.GearID"
                                                       class="form-control form-control-sm mt-1"
                                                       placeholder="Note for @gear.Brand @gear.ModelName (optional)" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small">
                                No gear registered yet. Add gear in the section below first.
                            </p>
                        }
                    </div>

                    <button type="submit" class="btn btn-primary">Log Session</button>

                </div>
            </div>
        </form>
    </div>

    @*SECTION 2 — GEAR REGISTRY*@
    <div class="mb-5">
        <h4 class="mb-3 border-bottom pb-2">👟 Gear Registry</h4>
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="get" class="mb-0">
                    <div class="row align-items-center">
                        <div class="col-md-8 col-lg-6">
                            <label for="searchString" class="form-label fw-semibold">Search Gear</label>
                            <div class="input-group">
                                <input type="text"
                                       id="searchString"
                                       name="searchString"
                                       class="form-control"
                                       placeholder="Search by Brand or Model..."
                                       value="@Request.Query["searchString"]" />
                                
                                <button type="submit" class="btn btn-primary">
                                    Search
                                </button>
                                
                                <a href="/" class="btn btn-outline-secondary">
                                    Clear
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light fw-semibold">
                @(Model.IsEditGear ? "✏️ Edit Gear" : "➕ Add New Gear")
         
                @if (Model.IsEditGear)
                {
                    @* EDIT FORM*@
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="editGear" />
                        <input type="hidden" name="GearID" value="@Model.CurrentGear.GearID" />

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Brand</label>
                                <input type="text" name="Brand" class="form-control"
                                       value="@Model.CurrentGear.Brand" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Model Name</label>
                                <input type="text" name="ModelName" class="form-control"
                                       value="@Model.CurrentGear.ModelName" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Category</label>
                                <select name="Category" class="form-select">
                                    @foreach (var cat in categories)
                                    {
                                        if (cat == Model.CurrentGear.Category)
                                        {
                                            <option value="@cat" selected>@cat</option>
                                        }
                                        else
                                        {
                                            <option value="@cat">@cat</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Purchase Date</label>
                                <input type="date" name="PurchaseDate" class="form-control"
                                       value="@Model.CurrentGear.PurchaseDate" />
                            </div>
                        </div>
                        <div class="mt-3 d-flex gap-2">
                            <button type="submit" class="btn btn-success">Update Gear</button>
                            <a href="/" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                }
                else
                {
 
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="addGear" />

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Brand</label>
                                <input type="text" name="Brand" class="form-control"
                                       placeholder="e.g. Nike" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Model Name</label>
                                <input type="text" name="ModelName" class="form-control"
                                       placeholder="e.g. Pegasus 41" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Category</label>
                                <select name="Category" class="form-select">
                                    <option value="">-- Select --</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Purchase Date</label>
                                <input type="date" name="PurchaseDate" class="form-control" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">Add Gear</button>
                        </div>
                    </form>
                }

            </div>
        </div>

        @* Gear Table *@
        @if (Model.Gears.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover table-bordered mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Brand</th>
                                <th>Model Name</th>
                                <th>Category</th>
                                <th>Purchase Date</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var gear in Model.Gears)
                            {
                                <tr>
                                    <td>@gear.GearID</td>
                                    <td>@gear.Brand</td>
                                    <td>@gear.ModelName</td>
                                    <td>
                                        <span class="badge bg-secondary">@gear.Category</span>
                                    </td>
                                    <td>@gear.PurchaseDate</td>
                                    <td class="text-center">
                                        <a href="/?editGearId=@gear.GearID"
                                           class="btn btn-sm btn-outline-primary me-1">Edit</a>

                                        <a href="/?deleteGearId=@gear.GearID"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Delete @gear.Brand @gear.ModelName?');">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                No gear registered yet. Use the form above to add gear.
            </div>
        }
    </div>

    @*SECTION 3 — RECENT SESSIONS*@
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
            <h4 class="mb-0">🕐 Recent Sessions</h4>
            <a asp-page="/Sessions" class="btn btn-sm btn-outline-dark">View All Sessions →</a>
        </div>

        @if (Model.RecentSessions.Any())
        {
            <div class="row g-3">
                @foreach (var session in Model.RecentSessions)
                {
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-dark text-white">
                                📅 @session.ActivityDate
                            </div>
                            <div class="card-body">
                                <h6 class="card-title">📍 @session.Location</h6>
                                <ul class="list-unstyled mb-3">
                                    <li>
                                        <span class="text-muted">Distance:</span>
                                        <strong>@session.Distance_KM.ToString("F1") km</strong>
                                    </li>
                                    <li>
                                        <span class="text-muted">Duration:</span>
                                        <strong>@session.Duration</strong>
                                    </li>
                                    <li>
                                        <span class="text-muted">Avg BPM:</span>
                                        <strong>@session.AvgHeartRate</strong>
                                    </li>
                                </ul>
                                <a asp-page="/Sessions/Index" class="btn btn-sm btn-outline-dark w-100">
                                    View All Sessions →
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                No sessions logged yet. Use the form above to log your first run!
            </div>
        }
    </div>

</div>

<script>
    function toggleNote(checkbox, panelId) {
        var panel = document.getElementById(panelId);
        if (panel) {
            panel.style.display = checkbox.checked ? 'block' : 'none';
            if (!checkbox.checked) {
                panel.querySelector('input').value = '';
            }
        }
    }
</script>
