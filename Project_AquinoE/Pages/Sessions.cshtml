@page
@model RunningGearTracker_AquinoE.Pages.Sessions.IndexModel
@{
    ViewData["Title"] = "All Sessions";
}

@* ── NAVBAR ──────────────────────────────────────────────────────────────── *@
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">🏃 Running Gear Tracker</a>
        <div class="navbar-nav ms-auto">
            <a class="nav-link" href="/">Dashboard</a>
            <a class="nav-link active" href="/Sessions">All Sessions</a>
            <a class="nav-link" href="/GearIndex">Gear Usage</a>
        </div>
    </div>
</nav>
<div class="container py-4">

    @* SECTION 1 — ADD / EDIT SESSION FORM *@
    <div class="mb-5">
        <h4 class="mb-3 border-bottom pb-2">
            @(Model.IsEditSession ? "✏️ Edit Session" : "➕ Add New Session")
        </h4>

        <div class="card shadow-sm">
            <div class="card-body">

                @if (Model.IsEditSession)
                {
                    @* EDIT FORM — pre-filled from CurrentSession loaded in OnGet *@
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="editSession" />
                        <input type="hidden" name="SessionID" value="@Model.CurrentSession.SessionID" />

                        <div class="row g-3">
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Date</label>
                                <input type="date" name="ActivityDate" class="form-control"
                                       value="@Model.CurrentSession.ActivityDate" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Location</label>
                                <input type="text" name="Location" class="form-control"
                                       value="@Model.CurrentSession.Location" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Distance (km)</label>
                                <input type="number" name="Distance_KM" step="0.01" min="0"
                                       class="form-control" value="@Model.CurrentSession.Distance_KM" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Duration</label>
                                <input type="text" name="Duration" class="form-control"
                                       value="@Model.CurrentSession.Duration" placeholder="hh:mm:ss" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Avg Heart Rate</label>
                                <input type="text" name="AvgHeartRate" class="form-control"
                                       value="@Model.CurrentSession.AvgHeartRate" placeholder="bpm" />
                            </div>
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <button type="submit" class="btn btn-success">Update Session</button>
                            <a href="/Sessions" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                }
                else
                {
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="addSession" />

                        <div class="row g-3">
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Date</label>
                                <input type="date" name="ActivityDate" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Location</label>
                                <input type="text" name="Location" class="form-control"
                                       placeholder="e.g. Rizal Park" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Distance (km)</label>
                                <input type="number" name="Distance_KM" step="0.01" min="0"
                                       class="form-control" placeholder="0.00" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Duration</label>
                                <input type="text" name="Duration" class="form-control"
                                       placeholder="hh:mm:ss" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Avg Heart Rate</label>
                                <input type="text" name="AvgHeartRate" class="form-control"
                                       placeholder="bpm" />
                            </div>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">Add Session</button>
                        </div>
                    </form>
                }

            </div>
        </div>
    </div>

    @* SECTION 2 — SEARCH AND SESSIONS TABLE *@
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="mb-0">
                <div class="row align-items-center">
                    <div class="col-md-8 col-lg-6">
                        <label for="searchString" class="form-label fw-bold">Search Sessions</label>
                        <div class="input-group">
                            <input type="text"
                                   id="searchString"
                                   name="searchString"
                                   class="form-control"
                                   placeholder="Search by Date/Location/Distance/Duration/Avg BPM..."
                                   value="@Request.Query["searchString"]" />
                            
                            <button type="submit" class="btn btn-primary">Search</button>
                            <a href="/Sessions" class="btn btn-outline-secondary">Clear</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="mb-4">
        <h4 class="mb-3 border-bottom pb-2">📋 All Sessions</h4>

        @if (Model.AllSessions.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover table-bordered mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Distance (km)</th>
                                <th>Duration</th>
                                <th>Avg BPM</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in Model.AllSessions)
                            {
                                bool isViewing = Model.ViewGearSessionId == session.SessionID;

                                <tr class="@(isViewing ? "table-warning" : "")">
                                    <td>@session.SessionID</td>
                                    <td>@session.ActivityDate</td>
                                    <td>@session.Location</td>
                                    <td>@session.Distance_KM.ToString("F1")</td>
                                    <td>@session.Duration</td>
                                    <td>@session.AvgHeartRate</td>
                                    <td class="text-center" style="white-space:nowrap;">

                                        @* View Gear toggle *@
                                        @if (isViewing)
                                        {
                                            <a href="/Sessions"
                                                   class="btn btn-sm btn-warning me-1">
                                                👟 Hide Gear
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="/Sessions?viewGearSessionId=@session.SessionID"
                                                   class="btn btn-sm btn-outline-warning me-1">
                                                👟 View Gear
                                            </a>
                                        }

                                        @* Edit Session *@
                                        <a href="/Sessions?editSessionId=@session.SessionID"
                                           class="btn btn-sm btn-outline-primary me-1">Edit</a>

                                        @* Delete Session *@
                                        <a href="/Sessions?deleteSessionId=@session.SessionID"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Delete this session and all its gear links?');">Delete</a>
                                    </td>
                                </tr>

                                @* ── Inline Gear Panel*@
                                @if (isViewing)
                                {
                                    <tr>
                                        <td colspan="7" class="p-0">
                                            <div class="bg-light border-top border-bottom p-3">

                                                <h6 class="fw-bold mb-3">
                                                    👟 Gear for Session #@session.SessionID
                                                    — @session.Location (@session.ActivityDate)
                                                </h6>

                                                @* Gear Usage Table *@
                                                @if (Model.SessionGearUsages.Any())
                                                {
                                                    <table class="table table-sm table-bordered bg-white mb-3">
                                                        <thead class="table-secondary">
                                                            <tr>
                                                                <th>Usage ID</th>
                                                                <th>Gear</th>
                                                                <th>Category</th>
                                                                <th>Notes</th>
                                                                <th class="text-center">Actions</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var usage in Model.SessionGearUsages)
                                                            {
                                                                bool editingThis = Model.IsEditUsage
                                                                                   && Model.CurrentUsage.UsageID == usage.UsageID;
                                                                <tr>
                                                                    @if (editingThis)
                                                                    {
                                                                        @* Inline edit row *@
                                                                        <td>@usage.UsageID</td>
                                                                        <td colspan="3">
                                                                            <form method="post" class="d-flex gap-2 align-items-center flex-wrap">
                                                                                @Html.AntiForgeryToken()
                                                                                <input type="hidden" name="action" value="editUsage" />
                                                                                <input type="hidden" name="UsageID" value="@usage.UsageID" />
                                                                                <input type="hidden" name="UsageSessionID" value="@usage.SessionID" />

                                                                                <select name="GearID" class="form-select form-select-sm"
                                                                                        style="width:auto;">
                                                                                    @foreach (var gear in Model.AllGears)
                                                                                    {
                                                                                        if (gear.GearID == Model.CurrentUsage.GearID)
                                                                                        {
                                                                                            <option value="@gear.GearID" selected>
                                                                                                @gear.Brand @gear.ModelName
                                                                                            </option>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <option value="@gear.GearID">
                                                                                                @gear.Brand @gear.ModelName
                                                                                            </option>
                                                                                        }
                                                                                    }
                                                                                </select>

                                                                                <input type="text" name="Notes"
                                                                                       class="form-control form-control-sm"
                                                                                       value="@Model.CurrentUsage.Notes"
                                                                                       placeholder="Notes"
                                                                                       style="width:200px;" />

                                                                                <button type="submit" class="btn btn-sm btn-success">Save</button>
                                                                                <a href="/Sessions?viewGearSessionId=@session.SessionID"
                                                                                   class="btn btn-sm btn-outline-secondary">Cancel</a>
                                                                            </form>
                                                                        </td>
                                                                        <td></td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>@usage.UsageID</td>
                                                                        <td>@usage.Gear?.Brand @usage.Gear?.ModelName</td>
                                                                        <td>
                                                                            <span class="badge bg-secondary">
                                                                                @usage.Gear?.Category
                                                                            </span>
                                                                        </td>
                                                                        <td>
                                                                            @if (string.IsNullOrEmpty(usage.Notes))
                                                                            {
                                                                                <span class="text-muted fst-italic">No notes</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                @usage.Notes
                                                                            }
                                                                        </td>
                                                                        <td class="text-center" style="white-space:nowrap;">
                                                                            <a href="/Sessions?editUsageId=@usage.UsageID&viewGearSessionId=@session.SessionID"
                                                                               class="btn btn-sm btn-outline-primary me-1">Edit</a>

                                                                            <a href="/Sessions?deleteUsageId=@usage.UsageID"
                                                                               class="btn btn-sm btn-outline-danger"
                                                                               onclick="return confirm('Remove this gear from the session?');">Remove</a>
                                                                        </td>
                                                                    }
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-info py-2 mb-3">
                                                        No gear linked to this session yet.
                                                    </div>
                                                }

                                                @* Add Gear Usage Form *@
                                                @if (!Model.IsEditUsage)
                                                {
                                                    <div class="card">
                                                        <div class="card-header bg-white fw-semibold">
                                                            ➕ Add Gear to This Session
                                                        </div>
                                                        <div class="card-body">
                                                            @if (Model.AllGears.Any())
                                                            {
                                                                <form method="post">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="action" value="addUsage" />
                                                                    <input type="hidden" name="UsageSessionID" value="@session.SessionID" />

                                                                    <div class="row g-2 align-items-end">
                                                                        <div class="col-md-4">
                                                                            <label class="form-label fw-semibold">Gear</label>
                                                                            <select name="GearID" class="form-select">
                                                                                <option value="">-- Select Gear --</option>
                                                                                @foreach (var gear in Model.AllGears)
                                                                                {
                                                                                    <option value="@gear.GearID">
                                                                                        @gear.Brand @gear.ModelName (@gear.Category)
                                                                                    </option>
                                                                                }
                                                                            </select>
                                                                        </div>
                                                                        <div class="col-md-5">
                                                                            <label class="form-label fw-semibold">Notes</label>
                                                                            <input type="text" name="Notes" class="form-control"
                                                                                   placeholder="Optional note about this gear..." />
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <button type="submit" class="btn btn-primary w-100">
                                                                                Add Gear
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                </form>
                                                            }
                                                            else
                                                            {
                                                                <p class="text-muted mb-0">
                                                                    No gear in registry.
                                                                    <a href="/">Add gear on the Dashboard</a>.
                                                                </p>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                No sessions logged found.
                <a href="/">Go to the Dashboard</a> to log your first session.
            </div>
        }
    </div>

</div>