<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Running Gear Tracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Project_AquinoE.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    


    @* ── MAIN CONTENT AREA ─────────────────────────────────────────────────── *@
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* ── CLEAN FOOTER ──────────────────────────────────────────────────────── *@
    <footer class="border-top footer text-muted mt-5 bg-white">
        <div class="container text-center py-3">
            &copy; 2026 - Running Gear Tracker | Aquino, Edrel P.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>